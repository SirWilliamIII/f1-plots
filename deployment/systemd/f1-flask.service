[Unit]
Description=F1 Telemetry Flask Application
After=network.target f1-beam-proxy.service
Wants=f1-beam-proxy.service

[Service]
Type=simple
User=will
WorkingDirectory=/home/will/f1-plots
Environment="PATH=/home/will/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_ENV=production"
Environment="PORT=5151"
Environment="OLLAMA_BASE_URL=http://localhost:11435"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/home/will/f1-plots/.env.prod
ExecStart=/home/will/.local/bin/uv run run.py
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5
StandardOutput=append:/home/will/f1-plots/logs/flask.log
StandardError=append:/home/will/f1-plots/logs/flask.error.log

[Install]
WantedBy=multi-user.target
